<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network for scans. A scan Tj starts keeps running when he switches apps: a foreground
         service (dataSync) holds the process for exactly that scan, with a progress notification
         and a partial wake lock (capped at 20 minutes), then stops itself.
         Background auto-scan (v0.18.0, off by default, Tj 2026-09-28): a foreground service
         (specialUse) while it's on, woken by an exact alarm every 5-40 minutes (USE_EXACT_ALARM;
         SCHEDULE_EXACT_ALARM before Android 13), restarted after a reboot or an update. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Test key tries the other connection (mobile data / Wi-Fi) when Novig flags this one's address. -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- "Let Vigilant run in the background" in Settings: Android's own one-tap prompt. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- The floating widget over Novig (FloatingWidget.kt): a small window Tj can touch, drawn
         over other apps. Android asks him once ("Display over other apps"); without it the
         widget is picture-in-picture. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- "Open Novig" opens Novig's app when it's installed (Android 11+ package visibility). -->
    <queries>
        <package android:name="us.novig.app" />
    </queries>

    <application
        android:name=".VigilantApp"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        tools:targetApi="31"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Vigilant"
        android:supportsRtl="true"
        android:largeHeap="true">
        <!-- largeHeap (Tj's Diagnostics, 2026-10-01: an OutOfMemoryError at the 256 MB default mid-scan, with no limit set on a scan across seven
             leagues): a scan holds every source's boards and a whole priced result, which a data app like this needs room for. [MemoryGuard] ends a
             scan early instead of crashing when even this fills. -->

        <!-- The mini window: picture-in-picture over Novig (MiniWindow.kt). configChanges keeps
             the activity alive through the resize instead of recreating it; resizeable also lets
             Tj run Vigilant and Novig side by side in split screen. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:supportsPictureInPicture="true"
            android:resizeableActivity="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation"
            android:theme="@style/Theme.Vigilant">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".ScanService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name=".AutoScanService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Scans sports odds on a schedule the user picks and alerts on new +EV bets" />
        </service>

        <!-- Pinnodds live (Tj, 2026-10-08): holds the process and the CPU awake while the live feed is on, so Pinnacle's prices keep reaching it with the screen off. -->
        <service
            android:name=".LiveFeedService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the Pinnodds live odds connection running in the background so live bets can react to price moves" />
        </service>

        <!-- Research (Tj, 2026-10-10): holds the process awake while research mode is on, so the paper lab and paper bids keep recording in the background. -->
        <service
            android:name=".ResearchService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the paper-only research recorders running in the background to log odds and simulated bids" />
        </service>

        <!-- The +EV alert's "✓ Placed" and the confirmation's "Undo": run in the background, no screen. -->
        <receiver
            android:name=".AlertActionReceiver"
            android:exported="false" />

        <!-- A recommended bid's "Approve" and "Deny" (make orders, auto-make off): run in the background, no screen. -->
        <receiver
            android:name=".MakerActionReceiver"
            android:exported="false" />

        <!-- The closing-line capture's alarm, a few minutes before each open bet's start (ClosingCapture.kt). -->
        <receiver
            android:name=".ClosingReceiver"
            android:exported="false" />

        <!-- WorkManager's expedited work runs as this service before Android 12 (the closing capture): its type, for Android 14+. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <receiver
            android:name=".AutoScanReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Hands the diagnostics file to the app Tj shares it with (Claude): only cache/diagnostics/, see res/xml/file_paths.xml. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
