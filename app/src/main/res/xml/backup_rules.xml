<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older. Everything the app saves is backed up (api_keys.json, settings,
     tracked bets, usage), except the Novig key connection: it points at a key inside this
     phone's secure hardware, which can't be restored anywhere else. cno.json is only a cache of
     CrazyNinjaOdds' last list, re-read on the next launch, and teams.json a cache of ESPN's
     rosters. placed.json (bets Tj marked placed) is his own record and is backed up.
     novig_management_key.json (the saved Novig management key) is sealed by this phone's Keystore,
     so it can't be opened anywhere else: it's left out too. -->
<full-backup-content>
    <exclude domain="file" path="datastore/vigilant_api_keys.preferences_pb" />
        <exclude domain="file" path="novig_management_key.json" />
        <exclude domain="file" path="cno.json" />
        <exclude domain="file" path="teams.json" />
        <exclude domain="file" path="cno_links.json" />
</full-backup-content>
